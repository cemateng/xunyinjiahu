/* 商品卡片组件样式 */
.goods-card {
  background: #fff; border-radius: 18rpx; overflow: hidden;
  box-shadow: 0 2rpx 14rpx rgba(107, 58, 26, 0.05);
  border: 1rpx solid rgba(180, 150, 120, 0.08);
  transition: transform 0.15s;
}
.goods-card:active { transform: scale(0.97); }
.goods-img { width: 100%; height: 210rpx; }
.goods-info { padding: 14rpx 18rpx 18rpx; }
.goods-name {
  font-size: 26rpx; font-weight: 700; color: var(--text);
  display: block; margin-bottom: 8rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.goods-price-row { display: flex; align-items: baseline; gap: 10rpx; }
.goods-price { color: var(--danger); font-size: 32rpx; font-weight: 700; }
.goods-original { color: #B8A898; font-size: 22rpx; text-decoration: line-through; }
.goods-sales { color: #B8A898; font-size: 22rpx; display: block; margin-top: 6rpx; }
