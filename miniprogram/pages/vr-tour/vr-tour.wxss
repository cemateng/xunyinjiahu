/* VR云游页面样式 */
.scene-list { display: flex; gap: 18rpx; margin-bottom: 24rpx; overflow-x: auto; padding-bottom: 4rpx; }
.scene-card {
  flex-shrink: 0; width: 220rpx; text-align: center;
  padding: 14rpx; border-radius: 16rpx; background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(107, 58, 26, 0.04);
  border: 2rpx solid transparent; transition: all 0.2s;
}
.scene-card.active { border-color: var(--accent); box-shadow: 0 4rpx 16rpx rgba(107, 58, 26, 0.08); }
.scene-card image { width: 100%; height: 130rpx; border-radius: 10rpx; }
.scene-card text { display: block; margin-top: 10rpx; font-size: 26rpx; font-weight: 600; color: var(--text); }

.vr-container {
  width: 100%; height: 640rpx; border-radius: 20rpx;
  overflow: hidden; position: relative;
  background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}
.vr-canvas { width: 100%; height: 100%; }
.gesture-hint {
  position: absolute; bottom: 24rpx; left: 50%; transform: translateX(-50%);
  background: rgba(0,0,0,0.65); color: #F5E6D3; padding: 14rpx 28rpx;
  border-radius: 36rpx; font-size: 22rpx;
  display: flex; gap: 28rpx; backdrop-filter: blur(4px);
}

.scene-info { padding: 24rpx; }
.scene-name { font-size: 36rpx; font-weight: 700; display: block; margin-bottom: 8rpx; color: var(--text); }
.scene-desc { color: var(--text-light); font-size: 26rpx; line-height: 1.6; }

.audio-btn {
  margin-top: 20rpx; text-align: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff; padding: 18rpx; border-radius: 44rpx;
  font-weight: 600; font-size: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(107, 58, 26, 0.2);
}
