/* 智能导览页面样式 */
.ar-entry {
  display: flex; align-items: center; gap: 22rpx;
  background: linear-gradient(135deg, #FFF8E1, #FFECB3);
  border-radius: 20rpx; padding: 28rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.12);
}
.ar-icon { font-size: 60rpx; }
.ar-title { font-size: 32rpx; font-weight: 700; display: block; color: var(--text); }
.ar-desc { font-size: 24rpx; color: var(--text-light); }
.arrow { margin-left: auto; font-size: 44rpx; color: var(--accent); }

.map-container { padding: 0; overflow: hidden; height: 380rpx; position: relative; border-radius: 20rpx; }
.mini-map { width: 100%; height: 380rpx; }
.location-text {
  position: absolute; top: 20rpx; left: 50%; transform: translateX(-50%);
  background: rgba(255,255,255,0.92); padding: 10rpx 28rpx;
  border-radius: 44rpx; font-size: 24rpx; color: var(--text);
  font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.spot-list { margin-bottom: 140rpx; }
.spot-item { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 24rpx; }
.spot-img { width: 150rpx; height: 108rpx; border-radius: 12rpx; flex-shrink: 0; }
.spot-info { flex: 1; overflow: hidden; }
.spot-name { font-size: 30rpx; font-weight: 700; display: block; color: var(--text); }
.spot-desc { font-size: 24rpx; color: var(--text-light); display: block; margin: 6rpx 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.spot-dist { font-size: 22rpx; color: #B8A898; }
.audio-play-btn {
  width: 68rpx; height: 68rpx; border-radius: 50%;
  background: var(--accent); color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; box-shadow: 0 2rpx 10rpx rgba(198, 123, 75, 0.3);
}
