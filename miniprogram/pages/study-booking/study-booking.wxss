/* 研学预约页面样式 */
.tag-scroll { white-space: nowrap; margin-bottom: 24rpx; padding: 8rpx 0; }
.tag {
  display: inline-block; padding: 12rpx 30rpx; margin-right: 14rpx;
  background: #fff; border-radius: 36rpx; font-size: 26rpx;
  color: var(--text-light); border: 1rpx solid var(--border);
  transition: all 0.15s;
}
.tag.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff; border-color: transparent;
}

.route-card { overflow: hidden; padding: 0; margin-bottom: 24rpx; border-radius: 20rpx; }
.route-cover { width: 100%; height: 320rpx; }
.route-body { padding: 24rpx; }
.route-name { font-size: 34rpx; font-weight: 700; display: block; margin-bottom: 12rpx; color: var(--text); }
.route-tags { display: flex; gap: 8rpx; margin-bottom: 12rpx; flex-wrap: wrap; }
.r-tag { font-size: 22rpx; background: #FFF8E1; color: var(--gold); padding: 5rpx 16rpx; border-radius: 24rpx; font-weight: 500; }
.route-meta { display: flex; gap: 26rpx; font-size: 24rpx; color: var(--text-light); margin-bottom: 16rpx; }
.route-bottom { display: flex; justify-content: space-between; align-items: center; }
.route-price { font-size: 40rpx; font-weight: 700; color: var(--danger); }
.per { font-size: 24rpx; font-weight: 400; color: #B8A898; }
.btn-book {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff; padding: 14rpx 36rpx; border-radius: 36rpx;
  font-size: 28rpx; font-weight: 600;
  box-shadow: 0 3rpx 12rpx rgba(107, 58, 26, 0.2);
}

/* 详情弹窗 */
.detail-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55); z-index: 100;
  display: flex; align-items: flex-end;
  backdrop-filter: blur(2px);
}
.detail-panel {
  width: 100%; height: 88vh; background: var(--bg-warm);
  border-radius: 28rpx 28rpx 0 0; position: relative;
}
.detail-cover { width: 100%; height: 360rpx; border-radius: 28rpx 28rpx 0 0; }
.detail-close {
  position: absolute; top: 24rpx; right: 24rpx;
  width: 56rpx; height: 56rpx; background: rgba(0,0,0,0.35);
  color: #fff; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; z-index: 5;
}
.detail-scroll { height: calc(88vh - 360rpx); padding: 28rpx; }
.detail-name { font-size: 38rpx; font-weight: 700; display: block; margin-bottom: 14rpx; }
.detail-tags { display: flex; gap: 8rpx; margin-bottom: 16rpx; }
.detail-meta { display: flex; gap: 22rpx; font-size: 26rpx; color: var(--text-light); margin-bottom: 24rpx; flex-wrap: wrap; }
.detail-price { color: var(--danger); font-weight: 700; font-size: 30rpx; }

.highlight-item { display: block; padding: 10rpx 0; font-size: 28rpx; color: var(--text); }

.teacher-card { display: flex; align-items: center; gap: 18rpx; background: #fff; padding: 20rpx; border-radius: 16rpx; margin-bottom: 24rpx; }
.teacher-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; }
.teacher-name { font-weight: 700; font-size: 28rpx; display: block; }
.teacher-title { font-size: 24rpx; color: var(--text-light); }

.day-title { font-size: 30rpx; font-weight: 700; color: var(--primary); display: block; margin: 14rpx 0 8rpx; }
.day-item { display: block; font-size: 26rpx; color: var(--text-light); padding: 6rpx 0; padding-left: 20rpx; }

.book-btn { width: 100%; text-align: center; margin-top: 28rpx; }

/* 预约表单 */
.form-panel {
  width: 100%; max-height: 90vh; background: #fff;
  border-radius: 28rpx 28rpx 0 0; padding: 36rpx 32rpx 60rpx;
  overflow-y: auto;
}
.form-title { font-size: 38rpx; font-weight: 700; display: block; text-align: center; color: var(--text); }
.form-route { font-size: 26rpx; color: var(--text-light); display: block; text-align: center; margin-bottom: 28rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { font-size: 28rpx; color: var(--text); display: block; margin-bottom: 10rpx; font-weight: 600; }
.form-input { border: 1rpx solid var(--border); border-radius: 12rpx; padding: 18rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; background: #fff; }
.form-picker { border: 1rpx solid var(--border); border-radius: 12rpx; padding: 18rpx; font-size: 28rpx; color: var(--text); }
.form-textarea { border: 1rpx solid var(--border); border-radius: 12rpx; padding: 18rpx; font-size: 26rpx; width: 100%; height: 130rpx; box-sizing: border-box; }
.btn-cancel { text-align: center; color: #B8A898; padding: 24rpx; font-size: 28rpx; }

/* 成功弹窗 */
.success-panel {
  width: 82%; background: #fff; border-radius: 28rpx;
  padding: 64rpx 44rpx; margin: auto;
  text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14rpx;
}
.success-icon { font-size: 88rpx; }
.success-title { font-size: 40rpx; font-weight: 700; color: var(--text); }
.success-msg { font-size: 28rpx; color: var(--text-light); }
.success-order { font-size: 26rpx; color: #B8A898; background: var(--bg-warm); padding: 10rpx 28rpx; border-radius: 24rpx; }
