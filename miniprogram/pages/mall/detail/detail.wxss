.img-swiper, .main-img { width: 100%; height: 500rpx; }
.swiper-img { width: 100%; height: 100%; }

.goods-name { font-size: 34rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.goods-cat { font-size: 22rpx; color: #A1887F; background: #f5f0e8; padding: 4rpx 16rpx; border-radius: 20rpx; }
.price-row { margin: 16rpx 0 8rpx; display: flex; align-items: baseline; gap: 12rpx; }
.price { font-size: 44rpx; color: #E65100; font-weight: bold; }
.original { font-size: 26rpx; color: #999; text-decoration: line-through; }
.sales { font-size: 22rpx; color: #999; }
.desc { font-size: 28rpx; color: #6D4C41; line-height: 1.8; }

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0; background: #fff;
  padding: 16rpx 24rpx 30rpx; display: flex; align-items: center; gap: 16rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.cart-btn { position: relative; font-size: 44rpx; padding: 0 12rpx; }
.cart-count {
  position: absolute; top: -4rpx; right: 0;
  min-width: 32rpx; height: 32rpx; background: #E65100; color: #fff;
  border-radius: 16rpx; font-size: 18rpx; text-align: center; line-height: 32rpx;
}
.add-cart { flex: 1; text-align: center; padding: 18rpx 0; }
.buy-now { flex: 1; text-align: center; padding: 18rpx 0; }

/* 购买弹窗 */
.detail-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 100;
  display: flex; align-items: flex-end;
}
.buy-panel {
  width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx 50rpx;
}
.buy-title { font-size: 34rpx; font-weight: bold; display: block; text-align: center; margin-bottom: 20rpx; }
.buy-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; font-size: 28rpx; }
.total { border-top: 1rpx solid #eee; margin-top: 8rpx; padding-top: 16rpx; }
.total-price { font-size: 36rpx; color: #E65100; font-weight: bold; }
.qty-ctrl { display: flex; align-items: center; gap: 24rpx; }
.qty-ctrl text:nth-child(2) { font-size: 32rpx; font-weight: bold; }
.qty-ctrl text:first-child, .qty-ctrl text:last-child {
  width: 48rpx; height: 48rpx; border: 2rpx solid #D7CCC8; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}
.btn-cancel { text-align: center; color: #999; padding: 20rpx; font-size: 26rpx; }
