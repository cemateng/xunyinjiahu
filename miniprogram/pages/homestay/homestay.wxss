/* 民宿预订页面样式 */
.homestay-card { padding: 0; overflow: hidden; margin-bottom: 24rpx; border-radius: 20rpx; }
.hs-img { width: 100%; height: 320rpx; }
.hs-info { padding: 24rpx; }
.hs-name { font-size: 34rpx; font-weight: 700; display: block; color: var(--text); }
.hs-type {
  font-size: 22rpx; color: var(--primary);
  background: rgba(107, 58, 26, 0.05); padding: 4rpx 16rpx;
  border-radius: 24rpx; display: inline-block; margin: 8rpx 0;
}
.hs-meta { display: flex; gap: 28rpx; font-size: 26rpx; color: var(--text-light); margin: 10rpx 0; }
.hs-facilities { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 10rpx 0; }
.fac-tag {
  font-size: 22rpx; background: #E8F5E9; color: var(--success);
  padding: 5rpx 14rpx; border-radius: 24rpx; font-weight: 500;
}
.hs-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 14rpx; }
.hs-price { font-size: 40rpx; color: var(--danger); font-weight: 700; }
.per { font-size: 24rpx; font-weight: 400; color: #B8A898; }
.hs-rating { font-size: 26rpx; color: var(--gold); font-weight: 600; }
.empty-tip { text-align: center; padding: 140rpx; color: #B8A898; font-size: 28rpx; }
