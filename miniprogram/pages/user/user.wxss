/* 个人中心页面样式 */
.user-card {
  display: flex; align-items: center; gap: 24rpx;
  margin-bottom: 28rpx; padding: 28rpx;
}
.avatar { width: 108rpx; height: 108rpx; border-radius: 50%; background: linear-gradient(135deg, #E8D5C4, #D4BFA8); }
.nickname { font-size: 36rpx; font-weight: 700; display: block; color: var(--text); }
.phone { font-size: 24rpx; color: var(--text-light); }

.menu-section { margin-bottom: 28rpx; }
.menu-grid { display: flex; }
.menu-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 24rpx 0; font-size: 24rpx; color: var(--text-light);
}
.menu-icon { font-size: 44rpx; margin-bottom: 8rpx; }

.menu-list { background: #fff; border-radius: 20rpx; overflow: hidden; margin-bottom: 28rpx; box-shadow: 0 2rpx 14rpx rgba(107, 58, 26, 0.04); }
.menu-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 28rpx; border-bottom: 1rpx solid rgba(180, 150, 120, 0.07);
  font-size: 30rpx; color: var(--text);
}
.menu-row:last-child { border-bottom: none; }
.arrow { color: #ccc; font-size: 40rpx; }

.about { text-align: center; padding: 48rpx 0; color: #B8A898; font-size: 24rpx; line-height: 2; }
.about-desc { display: block; margin-top: 6rpx; }
