.tab-bar { display: flex; margin-bottom: 20rpx; background: #fff; border-radius: 12rpx; }
.tab { flex: 1; text-align: center; padding: 20rpx; font-size: 28rpx; color: #6D4C41; }
.tab.active { color: #8B4513; font-weight: bold; border-bottom: 4rpx solid #8B4513; }

.empty-tip { text-align: center; padding: 120rpx 0; color: #999; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.empty-icon { font-size: 80rpx; }

.cart-item { display: flex; align-items: center; gap: 16rpx; }
.cart-img { width: 120rpx; height: 100rpx; border-radius: 10rpx; }
.cart-info { flex: 1; }
.cart-name { font-size: 26rpx; font-weight: bold; display: block; }
.cart-price { color: #E65100; font-size: 28rpx; font-weight: bold; }

.qty-ctrl { display: flex; align-items: center; gap: 16rpx; }
.qty-ctrl text:first-child, .qty-ctrl text:last-child {
  width: 44rpx; height: 44rpx; border: 2rpx solid #D7CCC8; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 28rpx;
}
.del-btn { font-size: 36rpx; padding: 8rpx; }

.cart-footer {
  position: fixed; bottom: 0; left: 0; right: 0; background: #fff;
  padding: 16rpx 24rpx 30rpx; display: flex; justify-content: space-between;
  align-items: center; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.cart-total { font-size: 30rpx; color: #E65100; font-weight: bold; }

.status-bar { white-space: nowrap; margin-bottom: 16rpx; }
.st-item {
  display: inline-block; padding: 10rpx 22rpx; margin-right: 10rpx;
  font-size: 24rpx; color: #6D4C41; background: #fff; border-radius: 30rpx;
}
.st-item.active { background: #8B4513; color: #fff; }

.order-card { margin-bottom: 16rpx; }
.order-header { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.order-id { font-size: 22rpx; color: #999; }
.order-status { font-size: 24rpx; font-weight: bold; }
.status-0 { color: #E65100; }
.status-1 { color: #2E7D32; }
.status-2 { color: #1565C0; }
.status-3 { color: #999; }

.order-goods { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; border-top: 1rpx solid #f5f0e8; }
.order-img { width: 80rpx; height: 70rpx; border-radius: 8rpx; }
.order-info text { display: block; font-size: 24rpx; color: #6D4C41; }
.order-footer { text-align: right; padding-top: 10rpx; border-top: 1rpx solid #f5f0e8; }
.order-total { font-size: 28rpx; color: #E65100; font-weight: bold; }
