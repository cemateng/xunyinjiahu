/* 全局样式 - 寻音贾湖 · 九千年回响 */
page {
  --primary: #6D3A1A;
  --primary-light: #8B5A3C;
  --accent: #C67B4B;
  --gold: #B8860B;
  --gold-light: #D4A843;
  --bg-warm: #F7F2E9;
  --bg-white: #FFFBF5;
  --text: #2C1810;
  --text-light: #6B5344;
  --border: #D4C4B0;
  --bone-white: #FBF7F0;
  --danger: #C0392B;
  --success: #2E7D32;

  background-color: var(--bg-warm);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.7;
  font-family: "PingFang SC", "Noto Serif SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(107, 58, 26, 0.06);
  border: 1rpx solid rgba(180, 150, 120, 0.1);
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, #6D3A1A, #8B5A3C);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 22rpx 52rpx;
  border: none;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 16rpx rgba(107, 58, 26, 0.22);
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 18rpx 44rpx;
  font-weight: 500;
}

/* 通用标题 */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 22rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid var(--accent);
  letter-spacing: 1rpx;
}
